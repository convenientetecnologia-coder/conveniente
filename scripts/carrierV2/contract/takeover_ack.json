{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 2
    },
    "contractRevision": {
      "type": "integer",
      "const": 2
    },
    "carrierGeneration": {
      "type": "string",
      "format": "uuid"
    },
    "receipt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60000
    },
    "instanceId": {
      "type": "string",
      "format": "uuid"
    },
    "resourceId": {
      "type": "string",
      "format": "uuid"
    },
    "executorFence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "authorityEpoch": {
      "type": "string",
      "format": "uuid"
    },
    "closed": {
      "type": "boolean",
      "const": true
    },
    "activeFlows": {
      "type": "integer",
      "const": 0
    },
    "pendingConnects": {
      "type": "integer",
      "const": 0
    },
    "closingFlows": {
      "type": "integer",
      "const": 0
    }
  },
  "required": [
    "protocolVersion",
    "contractRevision",
    "carrierGeneration",
    "receipt",
    "instanceId",
    "resourceId",
    "executorFence",
    "authorityEpoch",
    "closed",
    "activeFlows",
    "pendingConnects",
    "closingFlows"
  ],
  "additionalProperties": false
}